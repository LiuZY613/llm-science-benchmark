# 复制此文件为 .env，填入你的 API Key
# cp .env.example .env

# DeepSeek API Key (https://api.deepseek.com)
BENCH_DS_KEY=sk-your-deepseek-key

# CST Cloud API Key (中科院磐石)
BENCH_CST_KEY=your-cst-key

# Kimi K2.6 API Token (https://platform.moonshot.cn)
BENCH_KIMI_TOKEN=sk-your-kimi-token

# MiMo V2.5 API Token (Xiaomi Token Plan)
BENCH_MIMO_TOKEN=tp-your-mimo-token

# Claude Code (Anthropic OAuth Max) — 留空则用 OAuth 订阅
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
